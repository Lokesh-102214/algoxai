# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real credentials.

# ── Supabase (public / anon keys are safe to expose in browser) ────────────
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
VITE_SUPABASE_URL=https://your_project_id.supabase.co

# ── AWS Core (IAM user with Bedrock + DynamoDB permissions) ───────────────
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=us-east-1

# ── Cognito ────────────────────────────────────────────────────────────────
VITE_COGNITO_REGION=eu-north-1
VITE_COGNITO_USER_POOL_ID=your_user_pool_id
VITE_COGNITO_APP_CLIENT_ID=your_app_client_id

# ── API Gateway — fill in AFTER running: sam deploy ───────────────────────
# VITE_AWS_API_HTTP_URL=https://XXXXXXXXXX.execute-api.us-east-1.amazonaws.com/prod
# VITE_AWS_API_WS_URL=wss://XXXXXXXXXX.execute-api.us-east-1.amazonaws.com/prod

# ── Lambda / Backend env vars (used in SAM template, not in browser) ──────
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_FALLBACK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
DYNAMODB_TABLE_NAME=algoxai-chat-history
DYNAMODB_WS_TABLE=algoxai-ws-connections
